shakthisolution.cloud {
    # 1. Supabase APIs (Kong Gateway)
    handle /rest/v1/* {
        reverse_proxy localhost:8000
    }
    handle /auth/v1/* {
        reverse_proxy localhost:8000
    }
    handle /realtime/v1/* {
        reverse_proxy localhost:8000
    }
    handle /storage/v1/* {
        reverse_proxy localhost:8000
    }

    # 2. CRM Frontend (Nginx)
    handle {
        reverse_proxy localhost:8181
    }
}

